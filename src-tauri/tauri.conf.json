{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pssst",
  "version": "0.12.26",
  "identifier": "com.irisla.pssst.desktop",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "Pssst", "width": 1040, "height": 760, "minWidth": 620, "minHeight": 620, "resizable": true }], "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] } } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}
