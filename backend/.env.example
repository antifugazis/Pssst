# PostgreSQL from docker-compose.yml
PSSST_DATABASE_URL=postgresql+asyncpg://pssst:pssst_dev@localhost:5433/pssst

# Where uploaded audio chunks and the connection secret are stored
PSSST_STORAGE_DIR=./data

# faster-whisper
PSSST_WHISPER_MODEL=medium
PSSST_WHISPER_DEVICE=cpu
PSSST_WHISPER_COMPUTE_TYPE=int8

# Optional server-side OpenRouter correction. The desktop app can also send
# its own credentials per request, so these are not required.
# PSSST_OPENROUTER_API_KEY=
# PSSST_OPENROUTER_MODEL=

# Public URL used to build connection links shown to the desktop app
PSSST_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Fixed bearer secret for /v1. When unset, a random secret is generated into
# PSSST_STORAGE_DIR/.connection-secret on first startup.
# PSSST_CONNECTION_SECRET=
